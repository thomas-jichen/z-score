# ── Access ────────────────────────────────────────────────────────────────
# Shared passphrase teammates type to reach the tool. Pick something long.
ZSCORE_PASSPHRASE=

# Signs the session cookie. Any long random string; `openssl rand -hex 32`.
# Required in production: without it the app refuses to start rather than
# falling back to a secret that is published in this repo.
ZSCORE_SESSION_SECRET=

# ── Search provider ───────────────────────────────────────────────────────
# Preferred. ~$0.30–1.00 per 1,000 queries, up to 100 results per query.
# Key from https://serper.dev
ZSCORE_SERPER_API_KEY=

# Optional fallback for an existing grandfathered key. Google discontinues the
# Custom Search JSON API on 2027-01-01 and no longer issues new keys, so this
# is a bridge, not a destination. Returns 10 results per call, 100 max total.
ZSCORE_GOOGLE_CSE_KEY=
ZSCORE_GOOGLE_CSE_CX=

# ── Profile enrichment ────────────────────────────────────────────────────
# Apify personal API token, from Settings → API & Integrations at apify.com.
# Runs harvestapi/linkedin-profile-scraper at $4 per 1,000 profiles. That one
# actor does both jobs: it enriches a profile and returns that profile's
# "People Also Viewed" list, which is what the seed-expansion path walks.
# No LinkedIn account and no cookies are involved.
ZSCORE_APIFY_TOKEN=

# Set to 1 to exercise the enrichment flow with generated profiles and spend
# nothing. The payloads are shaped like real ones — nested date objects, the
# structured `location.parsed` block, the moreProfiles fan-out — so the real
# parser runs rather than being bypassed.
ZSCORE_APIFY_MOCK=

# ── Term extraction (optional) ────────────────────────────────────────────
# Groq API key, from https://console.groq.com → API Keys. `GROQ_API_KEY` is
# also accepted.
#
# This powers one thing: reading credential names out of profile free text,
# which is what fills "Unmatched, but notable" on the taxonomy screen. Without
# it every screen still works — you lose new-term discovery, not the product.
#
# It never moves a score. An extracted term carries zero weight until someone
# promotes it, so the ranking stays reproducible and auditable.
ZSCORE_GROQ_API_KEY=

# Defaults to openai/gpt-oss-120b, roughly $0.0002 per profile. Override if
# Groq renames or retires the model, so that is a config change not a deploy.
ZSCORE_GROQ_MODEL=

# ── Spend guard ───────────────────────────────────────────────────────────
# Profiles one teammate may enrich per UTC day. Defaults to 500, about $2.
# The ceiling lives on the server so a loop in client code cannot talk it out
# of refusing.
ZSCORE_DAILY_PROFILE_CAP=

# ── Storage ───────────────────────────────────────────────────────────────
# Attach Upstash Redis in Vercel and the integration sets these for you.
# Without them the app writes to .data/ locally and refuses to pretend it is
# saving in production. KV_REST_API_* and ZSCORE_REDIS_REST_* also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
